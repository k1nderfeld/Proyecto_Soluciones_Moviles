NODE_ENV=development
PORT=8080
DATABASE_NAME=rock
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@example.test
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
GUEST_SESSION_TTL_HOURS=72

# Obtener una clave en la plataforma de GeoDex. Nunca subir el .env real a Git.
GEODEX_API_URL=https://geodex-ml-api-76365064073.southamerica-west1.run.app
GEODEX_API_KEY=
GEODEX_TIMEOUT_MS=30000
GEODEX_PREDICTIONS_PATH=predictions
GEODEX_ROCK_ID_PATH=catalog.rockId
GEODEX_ROCK_NAME_PATH=label
GEODEX_CONFIDENCE_PATH=confidence
GEODEX_CONFIDENCE_SCALE=percent

# Solo para pruebas o demostraciones locales. Siempre deshabilitado en producción.
ALLOW_SIMULATED_RECOGNITION=false
